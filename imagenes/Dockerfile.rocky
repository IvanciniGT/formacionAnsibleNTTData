# Maquina simulada del aula de Ansible — Rocky Linux.
#
# No es una imagen de aplicacion: es un destino SSH para que los alumnos
# practiquen. Lleva lo minimo para que Ansible funcione contra ella:
#   - sshd, que es como entra Ansible
#   - python3, que es lo que ejecutan los modulos en el destino
#   - sudo sin contrasena para el usuario ansible, para practicar 'become'
#
# Las claves autorizadas NO van dentro de la imagen: se montan desde un
# Secret. Asi se pueden rotar sin reconstruir nada.
FROM rockylinux:9

RUN dnf -y install openssh-server python3 sudo procps-ng iproute \
 && dnf clean all \
 && useradd -m -s /bin/bash ansible \
 && echo 'ansible ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ansible \
 && chmod 0440 /etc/sudoers.d/ansible \
 && mkdir -p /home/ansible/.ssh \
 && chown -R ansible:ansible /home/ansible/.ssh \
 && chmod 700 /home/ansible/.ssh

# Las claves llegan montadas en /claves (Secret) y el arranque las copia.
# No se montan directamente en .ssh porque sshd exige permisos estrictos
# que un volumen de Secret no puede dar.
COPY arranque.sh /usr/local/bin/arranque.sh
RUN chmod +x /usr/local/bin/arranque.sh

EXPOSE 22
CMD ["/usr/local/bin/arranque.sh"]
